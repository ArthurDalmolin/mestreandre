<%- include('partials/header') %>
<%- include('partials/menu') %>
<main class="admin-main" id="conteudo-admin">
  <div class="admin-page-top"><div><span class="admin-overline">PAINEL ADMINISTRATIVO</span><h1>Visão geral da loja</h1><p>Gerencie seu catálogo, acompanhe pedidos e mantenha tudo organizado em um só lugar.</p></div><a class="admin-btn admin-btn-solid" href="/admin/produtos/form-cadastrar"><i class="bi bi-plus-lg"></i> Cadastrar produto</a></div>
  <section class="admin-hero" aria-label="Resumo da loja">
    <div><span class="admin-hero-kicker"><i class="bi bi-stars"></i> SEU ESPAÇO DE GESTÃO</span><h2>O ritmo da sua loja<br>começa aqui.</h2><p>Atualize seus instrumentos, organize categorias e cuide de cada pedido com praticidade.</p><a href="/admin/produtos" class="admin-hero-link">Explorar produtos <i class="bi bi-arrow-right"></i></a></div>
    <div class="admin-hero-note" aria-hidden="true"><i class="bi bi-music-note-beamed"></i></div>
  </section>
  <section aria-label="Indicadores do catálogo" class="admin-kpi-grid">
    <a class="admin-kpi" href="/admin/produtos"><div class="admin-kpi-header"><span>Produtos cadastrados</span><span class="admin-kpi-icon pink"><i class="bi bi-box-seam"></i></span></div><strong><%= contagens.produtos %></strong><small><i class="bi bi-arrow-up-right"></i> Ver todos os produtos</small></a>
    <a class="admin-kpi" href="/admin/marcas"><div class="admin-kpi-header"><span>Marcas cadastradas</span><span class="admin-kpi-icon purple"><i class="bi bi-tags"></i></span></div><strong><%= contagens.marcas %></strong><small><i class="bi bi-arrow-up-right"></i> Gerenciar marcas</small></a>
    <a class="admin-kpi" href="/admin/categorias"><div class="admin-kpi-header"><span>Categorias ativas</span><span class="admin-kpi-icon amber"><i class="bi bi-collection"></i></span></div><strong><%= contagens.categorias %></strong><small><i class="bi bi-arrow-up-right"></i> Organizar categorias</small></a>
    <a class="admin-kpi" href="/admin/pedidos"><div class="admin-kpi-header"><span>Pedidos registrados</span><span class="admin-kpi-icon blue"><i class="bi bi-bag-check"></i></span></div><strong><%= contagens.pedidos %></strong><small><i class="bi bi-arrow-up-right"></i> Acompanhar pedidos</small></a>
  </section>
  <div class="admin-content-grid">
    <section class="admin-panel admin-wide"><div class="admin-panel-heading"><div><h2>Últimos produtos</h2><p>Itens cadastrados recentemente no catálogo</p></div><a href="/admin/produtos">Ver todos <i class="bi bi-arrow-right"></i></a></div>
      <% if(ultimosProdutos.length){ %><div class="admin-products-list"><% ultimosProdutos.forEach(produto=>{ %>
        <div class="admin-product-line"><a href="/admin/produtos/editar/<%= produto.id %>" class="admin-product-photo"><img src="<%= imagemUrl(produto.imagem||'') %>" onerror="this.onerror=null;this.src='<%= imagemReserva(produto.categoria) %>'" alt="<%= produto.nome %>" loading="lazy"></a><div class="admin-product-descr"><a href="/admin/produtos/editar/<%= produto.id %>"><%= produto.nome %></a><span><%= produto.marca||'Sem marca' %> · <%= produto.categoria||'Sem categoria' %></span></div><strong><%= formatarValor(produto.valor) %></strong><span class="admin-stock <%= produto.estoque>3?'ok':'low' %>"><%= produto.estoque>3?'Em estoque':produto.estoque>0?'Estoque baixo':'Esgotado' %></span><a href="/admin/produtos/editar/<%= produto.id %>" class="admin-product-edit" title="Editar <%= produto.nome %>"><i class="bi bi-pencil-square"></i></a></div>
      <% }) %></div><% }else{ %><div class="admin-empty"><i class="bi bi-box-seam"></i><p>Ainda não há produtos cadastrados.</p><a href="/admin/produtos/form-cadastrar">Cadastrar primeiro produto</a></div><% } %>
    </section>
    <section class="admin-panel admin-narrow"><div class="admin-panel-heading"><div><h2>Seu catálogo</h2><p>Produtos por categoria</p></div><a href="/admin/categorias" title="Editar categorias"><i class="bi bi-arrow-up-right"></i></a></div>
      <% if(distribuicao.length){ %><div class="admin-categories"><% distribuicao.forEach((categoria,index)=>{ %><div class="admin-category-row"><div><span><%= categoria.nome %></span><strong><%= categoria.quantidade %></strong></div><div class="admin-progress"><span style="width:<%= Math.max(4,Math.round(100*categoria.quantidade/Math.max(1,contagens.produtos))) %>%"></span></div></div><% }) %></div><% }else{ %><p class="admin-muted">As categorias aparecerão aqui após o cadastro de produtos.</p><% } %>
      <div class="admin-inventory-callout"><span class="admin-inventory-icon"><i class="bi bi-exclamation-circle"></i></span><div><strong><%= contagens.estoqueBaixo %> produto(s) com estoque baixo</strong><p>Itens com 3 unidades ou menos.</p><a href="/admin/produtos">Conferir estoque <i class="bi bi-arrow-right"></i></a></div></div>
    </section>
    <section class="admin-panel admin-wide"><div class="admin-panel-heading"><div><h2>Pedidos recentes</h2><p>Solicitações registradas para atendimento</p></div><a href="/admin/pedidos">Gerenciar pedidos <i class="bi bi-arrow-right"></i></a></div>
      <% if(ultimosPedidos.length){ %><div class="admin-order-list"><% ultimosPedidos.forEach(p=>{ %><div class="admin-order-line"><div><strong>Pedido #<%= p.id %></strong><small><%= p.nome||'Cliente' %> · <%= p.criado_em %></small></div><span class="admin-order-status"><%= p.status %></span><strong><%= formatarValor(p.valor_total) %></strong></div><% }) %></div><% }else{ %><div class="admin-empty admin-empty-short"><i class="bi bi-receipt"></i><p>Nenhum pedido registrado até o momento.</p></div><% } %>
    </section>
    <section class="admin-panel admin-narrow"><div class="admin-panel-heading"><div><h2>Ações rápidas</h2><p>Acesse as tarefas do dia a dia</p></div></div><div class="admin-quick-grid"><a href="/admin/produtos/form-cadastrar"><i class="bi bi-plus-circle"></i><span><strong>Novo produto</strong><small>Fotos, valores e especificações</small></span><i class="bi bi-arrow-right"></i></a><a href="/admin/marcas/cadastrar"><i class="bi bi-tags"></i><span><strong>Nova marca</strong><small>Adicione fabricantes ao catálogo</small></span><i class="bi bi-arrow-right"></i></a><a href="/admin/categorias/form-cadastrar"><i class="bi bi-collection"></i><span><strong>Nova categoria</strong><small>Organize seus instrumentos</small></span><i class="bi bi-arrow-right"></i></a><a href="/admin/fretes"><i class="bi bi-truck"></i><span><strong>Consultas de frete</strong><small><%= contagens.fretes %> consulta(s) registradas</small></span><i class="bi bi-arrow-right"></i></a></div></section>
  </div>
</main>
</div>
<%- include('partials/footer') %>
