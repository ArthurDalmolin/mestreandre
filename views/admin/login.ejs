<%- include('partials/header') %><main class="container py-5"><section class="card shadow-sm mx-auto" style="max-width:480px"><div class="card-header"><h1 class="h4 mb-0">Entrar na administração</h1></div><div class="card-body p-4"><% if(erro){ %><p class="alert alert-danger"><%= erro %></p><% } %><% if(configurado){ %><form method="post" action="/admin/login"><label class="form-label" for="senha">Senha do administrador</label><input type="password" class="form-control mb-3" id="senha" name="senha" required><button class="btn btn-primary w-100">Entrar</button></form><% }else{ %><p>Ainda não existe um administrador configurado neste projeto.</p><a class="btn btn-primary" href="/admin/configurar">Criar acesso inicial</a><% } %><a href="/inicial" class="d-block mt-3">Voltar à loja</a></div></section></main><%- include('partials/footer') %>