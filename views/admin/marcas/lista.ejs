<%- include('../partials/header') %><%- include('../partials/menu') %><main class="container py-4"><div class="d-flex justify-content-between align-items-center mb-3"><h1 class="h3">Marcas</h1><a class="btn btn-primary" href="/admin/marcas/cadastrar"><i class="bi bi-plus"></i> Cadastrar marca</a></div><div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>ID</th><th>Imagem</th><th>Nome</th><th>Ações</th></tr></thead><tbody><% marcas.forEach(m=>{ %><tr><td><%= m.id %></td><td><% if(m.imagem){ %><img src="<%= imagemUrl(m.imagem) %>" onerror="this.onerror=null;this.src='<%= '/img/acessorios.png' %>'" width="64" height="54" style="object-fit:contain" alt="<%= m.nome %>"><% } %></td><td><%= m.nome %></td><td><div class="d-flex gap-2"><a class="btn btn-sm btn-outline-primary" href="/admin/marcas/editar/<%= m.id %>">Editar</a><form method="post" action="/admin/marcas/excluir/<%= m.id %>" onsubmit="return confirm('Excluir a marca?')"><button class="btn btn-sm btn-outline-danger">Excluir</button></form></div></td></tr><% }) %></tbody></table></div><% if(!marcas.length){ %><p class="p-3">Nenhuma marca cadastrada.</p><% } %></div></main></div>
<%- include('../partials/footer') %>