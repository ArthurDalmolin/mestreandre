<%- include('../partials/header') %><%- include('../partials/menu') %><main class="container py-4"><div class="card shadow-sm"><div class="card-header"><h1 class="h4 mb-0"><%= marca?'Editar marca':'Cadastrar marca' %></h1></div><div class="card-body"><form action="<%= marca?'/admin/marcas/editar/'+marca.id:'/admin/marcas/cadastrar' %>" method="post" enctype="multipart/form-data"><label class="form-label">Nome da marca<input class="form-control" name="nome" value="<%= marca?marca.nome:'' %>" required maxlength="120"></label><label class="form-label d-block mt-3">Logotipo (opcional)<input class="form-control" type="file" name="imagem" accept="image/png,image/jpeg,image/webp,image/gif"></label><% if(marca&&marca.imagem){ %><p><img src="<%= imagemUrl(marca.imagem) %>" onerror="this.onerror=null;this.src='<%= '/img/acessorios.png' %>'" alt="Logo atual" height="90"></p><% } %><button class="btn btn-primary mt-3">Salvar marca</button> <a class="btn btn-outline-secondary mt-3" href="/admin/marcas">Cancelar</a></form></div></div></main></div>
<%- include('../partials/footer') %>