<%- include('partials/header') %><%- include('partials/menu') %><main class="container py-4"><h1 class="h3">Pedidos recebidos</h1><p>Pedidos são registrados para atendimento; não representam pagamentos confirmados.</p><div class="table-responsive"><table class="table table-striped"><thead><tr><th>Nº</th><th>Cliente</th><th>Valor</th><th>Data</th><th>Status</th></tr></thead><tbody><% pedidos.forEach(p=>{ %><tr><td><%= p.id %></td><td><%= p.nome %><br><%= p.email %></td><td><%= formatarValor(p.valor_total) %></td><td><%= p.criado_em %></td><td><form method="post" action="/admin/pedidos/<%= p.id %>/status" class="d-flex gap-2"><select name="status" class="form-select form-select-sm"><% ['aguardando atendimento','em preparação','concluído','cancelado'].forEach(s=>{ %><option value="<%= s %>" <%= p.status===s?'selected':'' %>><%= s %></option><% }) %></select><button class="btn btn-sm btn-primary">Salvar</button></form></td></tr><% }) %></tbody></table></div></main></div>
<%- include('partials/footer') %>