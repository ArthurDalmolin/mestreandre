<%- include('../partials/header') %><%- include('../partials/menu') %>
<main class="container py-4"><div class="d-flex justify-content-between align-items-center mb-3"><h1 class="h3"><%= produto?'Editar instrumento':'Cadastrar instrumento' %></h1><a href="/admin/produtos">Voltar à lista</a></div>
<form id="formProduto" method="post" enctype="multipart/form-data" action="<%= produto?'/admin/produtos/editar/'+produto.id:'/admin/produtos/cadastrar' %>" class="card shadow-sm p-4">
<h2 class="h5">Dados gerais</h2><div class="row g-3">
<div class="col-md-8"><label class="form-label">Nome do produto<input required name="nome" class="form-control" value="<%= produto?produto.nome:'' %>" maxlength="180"></label></div>
<div class="col-md-4"><label class="form-label">Modelo<input name="modelo" class="form-control" value="<%= produto?produto.modelo||'':'' %>"></label></div>
<div class="col-md-4"><label class="form-label">Categoria<select name="categoria" id="categoriaProduto" class="form-select" required><option value="">Selecione</option><% categorias.forEach(c=>{ %><option value="<%= c.nome %>" <%= produto&&produto.categoria===c.nome?'selected':'' %>><%= c.nome %></option><% }) %></select></label></div>
<div class="col-md-4"><label class="form-label">Marca<select name="marca" class="form-select"><option value="">Sem marca</option><% marcas.forEach(m=>{ %><option value="<%= m.nome %>" <%= produto&&produto.marca===m.nome?'selected':'' %>><%= m.nome %></option><% }) %></select></label><small><a href="/admin/marcas/cadastrar">Cadastrar nova marca</a> (salve o produto antes)</small></div>
<div class="col-md-4"><label class="form-label">Nível de habilidade<select name="nivel" class="form-select"><option value="">Selecione</option><% ['Iniciante','Intermediário','Avançado','Profissional','Todos os níveis'].forEach(n=>{ %><option value="<%= n %>" <%= produto&&produto.nivel===n?'selected':'' %>><%= n %></option><% }) %></select></label></div>
<div class="col-md-3"><label class="form-label">Valor (R$)<input type="number" step="0.01" min="0" name="valor" required class="form-control" value="<%= produto?produto.valor:'' %>"></label></div>
<div class="col-md-3"><label class="form-label">Estoque<input type="number" min="0" name="estoque" required class="form-control" value="<%= produto?produto.estoque:0 %>"></label></div>
<div class="col-md-6"><label class="form-label">Cor / acabamento<input name="cor" class="form-control" value="<%= produto?produto.cor||'':'' %>" placeholder="Ex.: Preto fosco"></label></div>
<div class="col-12"><label class="form-label">Descrição<textarea name="descricao" class="form-control" rows="4"><%= produto?produto.descricao||'':'' %></textarea></label></div>
</div><hr><h2 class="h5">Fotos do produto</h2><p class="text-muted">Selecione de 1 a 8 imagens (JPG, PNG, WebP ou GIF, até 5 MB cada). A primeira será a imagem principal no cadastro inicial.</p><input class="form-control" type="file" name="imagens" id="imagensProduto" multiple accept="image/png,image/jpeg,image/webp,image/gif" <%= produto?'':'required' %>><div id="previewUploads" class="d-flex gap-2 flex-wrap mt-3"></div>
<% if(produto&&imagens.length){ %><h3 class="h6 mt-4">Fotos cadastradas</h3><div class="d-flex flex-wrap gap-3"><% imagens.forEach(i=>{ %><div class="border rounded p-2 text-center" style="width:140px"><img src="<%= imagemUrl(i.arquivo) %>" onerror="this.onerror=null;this.src='<%= '/img/acessorios.png' %>'" alt="Foto do produto" style="width:120px;height:95px;object-fit:contain"><label class="d-block small"><input type="radio" name="capa_id" value="<%= i.id %>" <%= produto.imagem===i.arquivo?'checked':'' %>> Principal</label><button type="submit" form="excluirImagem<%= i.id %>" class="btn btn-sm btn-outline-danger mt-2" <%= imagens.length===1?'disabled':'' %>>Remover</button></div><% }) %></div><% } %>
<hr><div class="d-flex justify-content-between align-items-center flex-wrap gap-2"><div><h2 class="h5 mb-1">Especificações técnicas</h2><p class="text-muted mb-0">Preencha as especificações que são verdadeiras para este instrumento. A página do produto as mostra automaticamente.</p></div><button type="button" id="addSpec" class="btn btn-outline-primary">+ Adicionar campo</button></div>
<div id="specCampos" class="mt-3"><% especificacoes.forEach(s=>{ %><div class="row g-2 mb-2 spec-item"><div class="col-md-4"><input class="form-control" name="spec_chave[]" maxlength="90" value="<%= s.chave %>" placeholder="Ex.: Número de cordas"></div><div class="col-md-7"><input class="form-control" name="spec_valor[]" maxlength="700" value="<%= s.valor %>" placeholder="Ex.: 6"></div><div class="col-md-1"><button type="button" class="btn btn-outline-danger btn-remover-spec">×</button></div></div><% }) %></div>
<div class="d-flex gap-2 flex-wrap mt-4"><button class="btn btn-primary btn-lg" type="submit"><%= produto?'Salvar alterações':'Cadastrar produto' %></button><a href="/admin/produtos" class="btn btn-outline-secondary btn-lg">Cancelar</a></div></form>
<% if(produto){ imagens.forEach(i=>{ %><form id="excluirImagem<%= i.id %>" method="post" action="/admin/produtos/imagem/excluir/<%= i.id %>" onsubmit="return confirm('Remover esta foto?')"></form><% }); } %>
</main><script src="/js/admin-produto.js"></script></div>
<%- include('../partials/footer') %>