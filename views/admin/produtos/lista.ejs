<%- include('../partials/header') %><%- include('../partials/menu') %><main class="container py-4"><div class="d-flex justify-content-between align-items-center mb-3"><h1 class="h3">Produtos</h1><a href="/admin/produtos/form-cadastrar" class="btn btn-primary">+ Novo produto</a></div><div class="table-responsive bg-white rounded"><table class="table table-striped align-middle mb-0"><thead><tr><th>Foto</th><th>Produto</th><th>Marca</th><th>Categoria</th><th>Preço</th><th>Estoque</th><th>Ações</th></tr></thead><tbody><% produtos.forEach(p=>{ %><tr><td><img width="72" height="72" style="object-fit:contain" src="<%= imagemUrl(p.imagem) %>" onerror="this.onerror=null;this.src='<%= imagemReserva(p.categoria) %>'" alt="<%= p.nome %>"></td><td><strong><%= p.nome %></strong><br><small><%= p.modelo||'' %></small></td><td><%= p.marca||'—' %></td><td><%= p.categoria||'—' %></td><td><%= formatarValor(p.valor) %></td><td><%= p.estoque %></td><td><div class="d-flex gap-2 flex-wrap"><a class="btn btn-sm btn-outline-primary" href="/admin/produtos/editar/<%= p.id %>">Editar</a><a class="btn btn-sm btn-outline-secondary" target="_blank" rel="noopener" href="/produto/<%= p.id %>">Ver</a><form method="post" action="/admin/produtos/excluir/<%= p.id %>" onsubmit="return confirm('Excluir este produto?')"><button class="btn btn-sm btn-outline-danger">Excluir</button></form></div></td></tr><% }) %></tbody></table></div><% if(!produtos.length){ %><p>Cadastre o primeiro produto para começar.</p><% } %></main></div>
<%- include('../partials/footer') %>