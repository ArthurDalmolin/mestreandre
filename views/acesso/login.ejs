<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Instrumentos & Sons</title>
    
    <!-- Importação de Fontes do Google: Playfair Display (Serif) e Inter (Sans-serif) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS via CDN para estrutura rápida e consistente -->
    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        /* ==========================================================================
           CONFIGURAÇÃO DA IMAGEM DE FUNDO
           ========================================================================== */
        :root {
            /* >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
               COLOQUE O LINK OU O CAMINHO LOCAL DA SUA IMAGEM DE FUNDO AQUI ABAIXO:
               Exemplo local: url('sua-imagem.jpg')
               Exemplo web:   url('https://link-da-sua-imagem.com/foto.jpg')
            <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<< */
            --bg-image: url('/img/disco\ 1.png');
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #0b0707;
            background-image: var(--bg-image);
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            min-height: 100vh;
        }

        /* Tipografia clássica serifada idêntica ao design */
        .font-serif-custom {
            font-family: 'Playfair Display', Georgia, serif;
        }

        /* Efeito de vidro translúcido escuro do painel esquerdo */
        .glass-panel {
            background: rgba(18, 12, 12, 0.62);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
        }

        /* Cor exata do painel direito (quase preto/grafite profundo) */
        .card-right-bg {
            background-color: #171816;
        }

        /* Estilização suave para campos de entrada */
        .custom-input {
            background-color: #cfd2d1;
            color: #1a1a1a;
            transition: all 0.2s ease;
        }

        .custom-input::placeholder {
            color: #5d6363;
        }

        .custom-input:focus {
            background-color: #e2e5e4;
            outline: none;
            box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.4);
        }
    </style>
</head>
<body class="flex items-center justify-center p-4 selection:bg-red-800 selection:text-white">

    <!-- Container Central com duas seções (Esquerda Translúcida / Direita Sólida) -->
    <main class="w-full max-w-[890px] min-h-[510px] rounded-xl overflow-hidden shadow-2xl flex flex-col md:flex-row">
        
        <!-- ================= LADO ESQUERDO: TEXTOS PROMOCIONAIS ================= -->
        <section class="w-full md:w-1/2 glass-panel p-8 sm:p-12 md:p-14 flex flex-col justify-center text-white border-r border-white/5">
            <h1 class="font-serif-custom text-3xl sm:text-4xl leading-tight font-normal tracking-wide mb-6">
                Novas aventuras,<br>
                novos sons para<br>
                sua vida!
            </h1>
            <p class="text-xs sm:text-sm text-gray-200 font-light leading-relaxed max-w-xs">
                Os melhores instrumentos e acessórios para você estão aqui.
            </p>
        </section>

        <!-- ================= LADO DIREITO: FORMULÁRIO DE LOGIN ================= -->
        <section class="w-full md:w-1/2 card-right-bg p-8 sm:p-12 md:p-14 flex flex-col items-center justify-between text-white">
            
            <div class="w-full flex flex-col items-center">
                <!-- Ícone circular de perfil -->
                <div class="w-14 h-14 rounded-full bg-slate-300 flex items-center justify-center mb-5 text-[#171816] shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-9 h-9" viewBox="0 0 24 24" fill="currentColor">
                        <path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM3.751 20.105a8.25 8.25 0 0116.498 0 .75.75 0 01-.437.695A18.683 18.683 0 0112 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 01-.437-.695z" clip-rule="evenodd" />
                    </svg>
                </div>

                <!-- Título Login -->
                <h2 class="font-serif-custom text-3xl font-normal tracking-wide text-center mb-8">
                    Login
                </h2>

                <!-- Formulário com Inputs -->
                <form id="loginForm" class="w-full max-w-[280px] space-y-4" action="/acesso/login" method="POST">
                    
                    <!-- Campo: Usuário -->
                    <div class="relative flex items-center">
                        <span class="absolute left-3 text-gray-700 pointer-events-none">
                            <!-- Ícone Usuário -->
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                        </span>
                        <input 
                            type="text" 
                            id="username" 
                            name="email"
                            placeholder="Usuário" 
                            required
                            class="custom-input w-full pl-9 pr-4 py-2 text-xs rounded-lg placeholder-gray-600 focus:outline-none"
                        />
                    </div>

                    <!-- Campo: Senha (com ícone de envelope conforme a imagem) -->
                    <div class="relative flex items-center">
                        <span class="absolute left-3 text-gray-700 pointer-events-none">
                            <!-- Ícone Envelope / Carta -->
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                            </svg>
                        </span>
                        <input 
                            type="password" 
                            id="password" 
                            name="senha"
                            placeholder="Senha" 
                            required
                            class="custom-input w-full pl-9 pr-4 py-2 text-xs rounded-lg placeholder-gray-600 focus:outline-none"
                        />
                    </div>

                    <!-- Botão oculto ou acionado por Enter -->
                    <button type="submit" >Entrar</button>
                </form>
            </div>

            <!-- Links inferiores -->
            <div class="mt-12 text-center text-xs space-y-3 font-serif-custom">
                <div>
                    <a href="#cadastro" class="text-gray-300 hover:text-white transition-colors duration-150">
                        Ainda não tenho cadastro
                    </a>
                </div>
                <div>
                    <a href="#recuperar" class="text-gray-300 underline underline-offset-2 hover:text-white transition-colors duration-150">
                        Esqueceu sua senha?
                    </a>
                </div>
            </div>

            <!-- Feedback de mensagem (sem usar alerts) -->
            <div id="feedbackMessage" class="hidden mt-3 text-xs text-emerald-400 font-medium"></div>

        </section>
    </main>

    <!-- JavaScript para interação suave -->
    <script>
        function handleSubmit() {
            const user = document.getElementById('username').value.trim();
            const pass = document.getElementById('password').value.trim();
            const feedback = document.getElementById('feedbackMessage');

            if (user && pass) {
                feedback.textContent = `Acessando conta de ${user}...`;
                feedback.classList.remove('hidden');
                
                setTimeout(() => {
                    feedback.textContent = 'Autenticado com sucesso!';
                }, 1200);
            }
        }
    </script>
</body>
</html>