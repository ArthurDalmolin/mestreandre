<section class="cupom-card" aria-label="Cupons da compra">
  <h3><i class="bi bi-ticket-perforated"></i> Cupons de desconto</h3>
  <p class="cupom-help">Use <strong>FRETE2700</strong> para frete grátis em pedidos a partir de <strong>R$ 2.700,00</strong>. Toque a melodia do piano no rodapé para descobrir o cupom musical de 10%.</p>
  <% if(avisoCupom){ %><p class="cupom-aviso" role="status"><%= avisoCupom %></p><% } %>
  <form method="post" action="/carrinho/cupom" class="cupom-form">
    <input type="hidden" name="origem" value="<%= paginaCupom %>">
    <label for="cupomCodigo" class="visually-hidden">Código do cupom</label>
    <input id="cupomCodigo" type="text" name="codigo" maxlength="30" autocomplete="off" placeholder="Digite o código do cupom" required>
    <button type="submit">Aplicar</button>
  </form>
  <% if(promocao.cupomFrete){ %>
    <div class="cupom-aplicado">
      <span><i class="bi bi-truck"></i> FRETE2700: <%= promocao.freteGratis ? 'frete grátis disponível' : 'faltam ' + formatarValor(promocao.faltamFrete) %></span>
      <form method="post" action="/carrinho/remover-cupom"><input type="hidden" name="origem" value="<%= paginaCupom %>"><input type="hidden" name="tipo" value="frete"><button type="submit" aria-label="Remover cupom de frete">Remover</button></form>
    </div>
  <% } %>
  <% if(promocao.cupomDesconto){ %>
    <div class="cupom-aplicado">
      <span><i class="bi bi-music-note-beamed"></i> MESTRE10: 10% de desconto</span>
      <form method="post" action="/carrinho/remover-cupom"><input type="hidden" name="origem" value="<%= paginaCupom %>"><input type="hidden" name="tipo" value="desconto"><button type="submit" aria-label="Remover cupom musical">Remover</button></form>
    </div>
  <% } %>
</section>
