<!doctype html><html lang="pt-BR"><head><link rel="icon" type="image/png" href="/favicon.png"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Catálogo | Mestre André Store</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"><link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="/css/novas.css"><link rel="stylesheet" href="/css/site-shared.css"></head><body><%- include('../partials/header') %><div class="catalog-layout"><aside class="filters"><h2>Filtros</h2><form action="/catalogo" method="get"><input type="hidden" name="busca" value="<%= busca %>"><h3>Categoria</h3><select class="form-select" name="categoria" style="max-width:100%"><option value="">Todas</option><% categoriasMenu.forEach(c=>{ %><option value="<%= c.nome %>" <%= filtros.categoria===c.nome?'selected':'' %>><%= c.nome %></option><% }) %></select><hr><h3>Nível</h3><label><input type="radio" name="nivel" value="Iniciante" <%= filtros.nivel==='Iniciante'?'checked':'' %>> Iniciantes</label><label><input type="radio" name="nivel" value="Intermediário" <%= filtros.nivel==='Intermediário'?'checked':'' %>> Intermediário</label><label><input type="radio" name="nivel" value="Avançado" <%= filtros.nivel==='Avançado'?'checked':'' %>> Avançado</label><hr><h3>Preço</h3><label><input type="radio" name="preco" value="1500" <%= filtros.preco==='1500'?'checked':'' %>> Até 1.500 R$</label><label><input type="radio" name="preco" value="5000" <%= filtros.preco==='5000'?'checked':'' %>> Até 5.000 R$</label><label><input type="radio" name="preco" value="10000" <%= filtros.preco==='10000'?'checked':'' %>> Até 10.000 R$</label><label><input type="radio" name="preco" value="30000" <%= filtros.preco==='30000'?'checked':'' %>> Até 30.000 R$</label><hr><h3>Marca</h3><% marcas.forEach(m=>{ %><label><input type="radio" name="marca" value="<%= m.nome %>" <%= filtros.marca===m.nome?'checked':'' %>> <%= m.nome %></label><% }) %><hr><h3>Disponibilidade</h3><label><input type="checkbox" name="estoque" value="sim" <%= filtros.estoque==='sim'?'checked':'' %>> Imediata</label><button class="red-btn filter-submit">Filtrar</button><a href="/catalogo" class="d-block text-center mt-3">Limpar filtros</a></form></aside><main class="catalog-main"><div class="small text-muted mb-2">Modelos reais com preços, fotos ilustrativas e estoque de demonstração.</div><div class="sort-box">Classificado por <select id="sort"><option value="recommended">Recomendado →</option><option value="asc">Menor preço →</option><option value="desc">Maior preço →</option></select></div><div class="product-grid" id="product-grid"><% produtos.forEach(p=>{ %><article class="product-card" data-nome="<%= (p.nome||'').toLowerCase() %>" data-categoria="<%= (p.categoria||'').toLowerCase() %>" data-marca="<%= (p.marca||'').toLowerCase() %>" data-modelo="<%= (p.modelo||'').toLowerCase() %>" data-nivel="<%= (p.nivel||'').toLowerCase() %>" data-preco="<%= p.valor %>" data-estoque="<%= p.estoque %>"><a href="/produto/<%= p.id %>"><img src="<%= imagemUrl(p.imagem) %>" onerror="this.onerror=null;this.src='<%= imagemReserva(p.categoria) %>'" alt="<%= p.nome %>"></a><div class="product-caption"><a href="/produto/<%= p.id %>"><%= p.nome %></a><div class="product-bottom"><strong><%= Number(p.valor).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></strong><span>Envio Nacional</span></div><div style="display:flex;flex-wrap:wrap;justify-content:space-between;gap:4px"><form method="post" action="/favoritos/<%= p.id %>"><button class="heart-btn" title="Salvar favorito">♡ Favoritos</button></form><form method="post" action="/carrinho/adicionar/<%= p.id %>"><button class="heart-btn" <%= p.estoque<=0?'disabled':'' %>><%= p.estoque>0?'Adicionar à sacola':'Sem estoque' %></button></form></div></div></article><% }) %></div><p id="empty-results" hidden>Nenhum produto encontrado para esses filtros.</p></main></div><script src="/js/novas.js"></script><%- include('../partials/footer') %></body></html>