<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Meu perfil | Mestre André Store</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"><link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="/css/site-shared.css"><link rel="stylesheet" href="/css/perfil.css"></head><body>
<%- include('../partials/header') %>
<main class="profile-main container-fluid px-3 px-lg-5">
  <nav class="profile-breadcrumb"><a href="/inicial">Início</a> / Minha conta</nav>
  <header class="profile-intro"><div class="profile-avatar"><i class="bi bi-person-fill" aria-hidden="true"></i></div><div><span class="profile-label">ÁREA DO CLIENTE</span><h1><%= usuario.nome %></h1><p><%= usuario.email %></p></div><a class="profile-logout" href="/sair"><i class="bi bi-box-arrow-right"></i> Sair</a></header>
  <% if(erro){ %><div class="alert alert-danger"><%= erro %></div><% } %><% if(sucesso){ %><div class="alert alert-success"><%= sucesso %></div><% } %>
  <section class="profile-orders" aria-labelledby="titulo-pedidos">
    <div class="profile-orders-head"><div><span class="profile-label">ACOMPANHAMENTO</span><h2 id="titulo-pedidos">Meus pedidos</h2><p>Veja os produtos, valores e o andamento de cada compra.</p></div><a href="/catalogo" class="profile-outline-btn">Continuar comprando <i class="bi bi-arrow-right"></i></a></div>
    <% const emProcesso=pedidos.filter(p=>!/(enviado|caminho|entregue|cancelad)/i.test(p.status||'')); %>
    <% const aCaminho=pedidos.filter(p=>/(enviado|caminho|entregue)/i.test(p.status||'')); %>
    <% const cancelados=pedidos.filter(p=>/cancelad/i.test(p.status||'')); %>
    <div class="profile-tabs" role="group" aria-label="Filtrar pedidos">
      <button class="profile-tab active" type="button" data-filtro="todos">Todos (<%= pedidos.length %>)</button>
      <button class="profile-tab" type="button" data-filtro="processo">Em processo (<%= emProcesso.length %>)</button>
      <button class="profile-tab" type="button" data-filtro="caminho">A caminho (<%= aCaminho.length %>)</button>
      <button class="profile-tab" type="button" data-filtro="cancelado">Cancelados (<%= cancelados.length %>)</button>
    </div>
    <% if(!pedidos.length){ %><div class="profile-empty"><i class="bi bi-bag"></i><h3>Você ainda não fez pedidos.</h3><p>Explore os instrumentos e encontre seu próximo som.</p><a class="profile-solid-btn" href="/catalogo">Explorar catálogo</a></div><% } %>
    <div id="pedidosLista">
    <% pedidos.forEach(p=>{ const status=/(enviado|caminho|entregue)/i.test(p.status||'')?'caminho':/cancelad/i.test(p.status||'')?'cancelado':'processo'; %>
      <article class="profile-order" data-status="<%= status %>">
        <div class="profile-order-top"><div><span class="profile-order-label">PEDIDO #<%= p.id %></span><small><%= p.criado_em %></small></div><div><span class="profile-order-label">TOTAL</span><strong><%= formatarValor(p.valor_total) %></strong></div><div><span class="profile-order-label">STATUS</span><span class="profile-status"><i class="bi bi-circle-fill"></i> <%= p.status %></span></div><a class="profile-outline-btn" href="/carrinho/pedido/<%= p.id %>">Ver detalhes <i class="bi bi-arrow-up-right"></i></a></div>
        <div class="profile-order-products">
          <% p.itens.forEach(i=>{ %><div class="profile-order-product"><a href="/produto/<%= i.produto_id %>" class="profile-order-image"><% if(i.imagem){ %><img src="<%= imagemUrl(i.imagem) %>" alt="<%= i.nome %>" loading="lazy" onerror="this.onerror=null;this.src='/img/guitarras.png'"><% }else{ %><i class="bi bi-music-note-beamed"></i><% } %></a><div class="profile-order-product-name"><a href="/produto/<%= i.produto_id %>"><%= i.nome %></a><small>Quantidade: <%= i.quantidade %></small></div><strong><%= formatarValor(i.preco_unitario*i.quantidade) %></strong></div><% }) %>
        </div>
      </article>
    <% }) %>
    </div><p id="semPedidosFiltro" hidden>Nenhum pedido neste filtro.</p>
  </section>
  <div class="profile-bottom"><details class="profile-edit"><summary><i class="bi bi-person-gear"></i> Editar perfil <i class="bi bi-chevron-down"></i></summary><form action="/minha-conta/editar" method="post"><label>Nome<input type="text" name="nome" maxlength="100" minlength="2" value="<%= usuario.nome %>" required></label><label>E-mail<input type="email" name="email" maxlength="150" value="<%= usuario.email %>" required></label><button class="profile-solid-btn">Salvar alterações</button></form></details><div class="profile-shortcuts"><a href="/favoritos"><i class="bi bi-heart"></i> Meus favoritos</a><a href="/carrinho"><i class="bi bi-bag"></i> Minha sacola</a></div></div>
</main><%- include('../partials/footer') %><script src="/js/perfil.js" defer></script></body></html>