<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= produto.nome %> | Mestre André Store</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"><link rel="stylesheet" href="/css/produto.css"><link rel="stylesheet" href="/css/site-shared.css"><link rel="stylesheet" href="/css/produto-extra.css"></head><body>
<%- include('../partials/header') %>
<main class="container-fluid px-lg-5 py-4"><nav class="text-muted small mb-4"><a href="/inicial">Início</a> / <a href="/catalogo">Catálogo</a> / <%= produto.nome %></nav>
<div class="row gx-lg-5">
<div class="col-lg-7"><div class="main-image-viewport rounded-3 mb-3 d-flex align-items-center justify-content-center"><img id="mainProductImg" src="<%= imagemUrl(produto.imagem) %>" onerror="this.onerror=null;this.src='<%= imagemReserva(produto.categoria) %>'" alt="<%= produto.nome %>" class="img-fluid main-img"></div>
<div class="d-flex gap-3 thumbnail-strip flex-wrap" role="group" aria-label="Fotos do produto">
<% imagens.forEach((f,i)=>{ %><button type="button" class="thumb-box <%= i===0?'active':'' %>" data-image="<%= imagemUrl(f.arquivo) %>" aria-label="Mostrar foto <%= i+1 %> do produto" aria-pressed="<%= i===0?'true':'false' %>"><img src="<%= imagemUrl(f.arquivo) %>" onerror="this.onerror=null;this.src='<%= imagemReserva(produto.categoria) %>'" alt="Foto <%= i+1 %> de <%= produto.nome %>" loading="lazy"></button><% }) %>
</div></div>
<div class="col-lg-5 ps-lg-4 mt-4 mt-lg-0"><span class="text-muted text-uppercase small"><%= produto.marca||'Instrumento musical' %></span><h1 class="product-title mb-1"><%= produto.nome %></h1>
<% if(produto.modelo){ %><h2 class="product-model mb-3"><%= produto.modelo %></h2><% } %>
<p class="product-lead-text text-muted mb-3"><%= produto.descricao||'Instrumento selecionado para sua próxima história musical.' %></p>
<% if(avaliacoes.length){ const media=avaliacoes.reduce((s,a)=>s+a.nota,0)/avaliacoes.length; %><p class="text-warning"><i class="bi bi-star-fill"></i> <%= media.toFixed(1).replace('.',',') %> de 5 · <a href="#avaliacoes"><%= avaliacoes.length %> avaliações</a></p><% }else{ %><p class="small text-muted">Este instrumento ainda não recebeu avaliações.</p><% } %>
<hr class="opacity-25"><div class="product-price-value mb-1"><%= formatarValor(produto.valor) %></div><p class="small text-muted">Valor do produto. Frete e pagamento serão combinados com a loja.</p>
<% if(produto.cor){ %><p><strong>Cor:</strong> <%= produto.cor %></p><% } %><p><strong>Disponibilidade:</strong> <%= produto.estoque>0?produto.estoque+' unidade(s) em estoque':'Indisponível' %></p>
<% if(produto.estoque>0){ %><form action="/carrinho/adicionar/<%= produto.id %>" method="post" class="d-flex gap-2 mb-3 align-items-center flex-wrap"><label class="small">Quantidade <input id="qtdCompra" type="number" name="quantidade" value="1" min="1" max="<%= produto.estoque %>" class="form-control" style="width:110px" required></label><button type="submit" class="btn btn-bordeaux-add rounded-2 px-4" style="min-height:48px">Adicionar à sacola</button></form><% }else{ %><a href="/catalogo" class="btn btn-outline-dark mb-3">Ver outros instrumentos</a><% } %>
<form method="post" action="/favoritos/<%= produto.id %>"><button type="submit" class="btn btn-wishlist-pill w-100 rounded-2 mb-4 py-2"><i class="bi bi-heart<%= favorito?'-fill':'' %> me-2"></i><%= favorito?'Remover dos favoritos':'Salvar nos favoritos' %></button></form>
<div class="shipping-box border rounded-3 p-3 mb-2"><form method="post" action="/produto/<%= produto.id %>/consultar-frete"><label class="text-xs fw-semibold text-muted d-block mb-2">Consultar entrega no seu CEP</label><label class="small d-block mb-2">Seu e-mail ou telefone<input type="text" name="contato" required class="form-control" maxlength="140" placeholder="Para responder à consulta"></label><div class="d-flex gap-2"><input type="text" name="cep" class="form-control" id="cepInput" maxlength="9" placeholder="00000-000" inputmode="numeric" pattern="[0-9]{5}-?[0-9]{3}" required><button class="btn btn-sm btn-outline-secondary px-3 rounded-2">Consultar</button></div></form></div>
<% if(freteMensagem){ %><p class="alert alert-info mt-2"><%= freteMensagem %></p><% } %><p class="small text-muted">A consulta registra uma solicitação para a equipe. Não exibe frete fictício.</p>
</div></div>
<section class="product-tabs-wrapper mt-5 pt-3 border-top"><h2 class="specs-section-title mb-4">Sobre o instrumento</h2><div class="row gx-lg-5"><div class="col-lg-4 mb-4"><div class="specs-preview-box rounded-3 p-4 mb-3 d-flex justify-content-center align-items-center"><img src="<%= imagemUrl(produto.imagem) %>" onerror="this.onerror=null;this.src='<%= imagemReserva(produto.categoria) %>'" alt="<%= produto.nome %>" class="img-fluid"></div><p class="specs-desc-text text-muted"><%= produto.descricao||'' %></p></div>
<div class="col-lg-8"><h3 class="h5">Especificações técnicas de <%= produto.nome %></h3><div class="specs-table"><% if(especificacoes.length){ especificacoes.forEach(s=>{ %><div class="spec-row py-3 border-bottom d-flex justify-content-between gap-3"><span class="spec-label text-muted"><%= s.chave %></span><span class="spec-val fw-semibold text-end"><%= s.valor %></span></div><% }); }else{ %><p class="text-muted">A ficha técnica deste instrumento ainda não foi cadastrada. O administrador pode incluí-la em Editar produto.</p><% } %></div></div></div></section>
<section class="mt-5 pt-4 border-top" id="avaliacoes"><h2 class="h3 mb-4">Avaliações de clientes (<%= avaliacoes.length %>)</h2><% if(!avaliacoes.length){ %><p>Seja o primeiro a avaliar este instrumento.</p><% } %><% avaliacoes.forEach(a=>{ %><article class="border-bottom py-3"><div class="text-warning" aria-label="Nota <%= a.nota %> de 5"><%= '★'.repeat(a.nota) %><%= '☆'.repeat(5-a.nota) %></div><h3 class="h6 mt-2"><%= a.nome %></h3><p><%= a.comentario %></p><small class="text-muted"><%= a.criado_em %></small></article><% }); %>
<% if(usuarioAtual){ %><h3 class="h5 mt-4">Avaliar este produto</h3><% if(avaliacaoMensagem){ %><p class="alert alert-warning"><%= avaliacaoMensagem %></p><% } %><form method="post" action="/produto/<%= produto.id %>/avaliar" class="mb-4"><label class="form-label">Nota<select class="form-select" name="nota" required><option value="5">5 estrelas</option><option value="4">4 estrelas</option><option value="3">3 estrelas</option><option value="2">2 estrelas</option><option value="1">1 estrela</option></select></label><label class="form-label d-block">Sua avaliação<textarea class="form-control" name="comentario" rows="3" minlength="5" maxlength="1500" required></textarea></label><button class="btn btn-dark mt-2">Publicar avaliação</button></form><% }else{ %><p><a href="/login">Entre na sua conta para escrever uma avaliação.</a></p><% } %>
</section></main><%- include('../partials/footer') %><script src="/js/produto.js"></script></body></html>
