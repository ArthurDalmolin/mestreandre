<!doctype html><html lang="pt-BR"><head><link rel="icon" type="image/png" href="/favicon.png"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sua sacola | Mestre André Store</title><link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"><link rel="stylesheet" href="/css/site-shared.css"><link rel="stylesheet" href="/css/carrinho-extra.css"><link rel="stylesheet" href="/css/cupons.css"></head><body><%- include('../partials/header') %><main class="container py-5"><nav class="small text-muted"><a href="/inicial">Início</a> / Sua sacola</nav><p class="text-uppercase mt-5" style="letter-spacing:.18em;color:#75282d">Sua sacola</p><h1 class="cart-title">O próximo som está aqui.</h1><p class="text-muted">Confira seus instrumentos antes de registrar o pedido.</p>
<% if(!itens.length){ %><div class="card text-center p-5 my-4"><i class="bi bi-handbag display-3"></i><h2 class="h4 mt-3">Sua sacola está vazia.</h2><p>Explore os instrumentos e escolha seu próximo som.</p><a href="/catalogo" class="btn btn-dark mx-auto">Explorar catálogo</a></div><% }else{ %>
<div class="row g-4 mt-3"><div class="col-lg-8"><div class="card p-4"><h2 class="h5 mb-4">Produtos (<%= totalItens %>)</h2>
<% itens.forEach(item=>{ const p=item.produto; %><div class="d-flex gap-3 py-3 border-top align-items-center flex-wrap cart-line"><a href="/produto/<%= p.id %>"><img src="<%= imagemUrl(p.imagem) %>" onerror="this.onerror=null;this.src='<%= imagemReserva(p.categoria) %>'" alt="<%= p.nome %>" class="cart-photo"></a><div class="flex-grow-1"><small class="text-muted"><%= p.marca||'' %></small><h3 class="h6"><a href="/produto/<%= p.id %>"><%= p.nome %></a></h3><p class="small text-muted mb-1"><%= formatarValor(p.valor) %> por unidade</p><strong><%= formatarValor(item.subtotal) %></strong></div><div class="d-flex align-items-center gap-2"><form method="post" action="/carrinho/diminuir/<%= p.id %>"><button class="btn btn-outline-secondary" aria-label="Diminuir quantidade">−</button></form><strong><%= item.quantidade %></strong><form method="post" action="/carrinho/adicionar/<%= p.id %>"><button class="btn btn-outline-secondary" aria-label="Aumentar quantidade" <%= item.quantidade>=p.estoque?'disabled':'' %>>+</button></form></div><form method="post" action="/carrinho/remover/<%= p.id %>"><button class="btn btn-link text-danger" title="Remover produto" aria-label="Remover <%= p.nome %>"><i class="bi bi-trash"></i></button></form></div><% }); %>
<div class="d-flex justify-content-between mt-3"><a href="/catalogo" class="btn btn-outline-dark">Continuar comprando</a><form method="post" action="/carrinho/limpar" onsubmit="return confirm('Esvaziar toda a sacola?')"><button class="btn btn-outline-danger">Esvaziar sacola</button></form></div></div></div>
<aside class="col-lg-4"><div class="card p-4 cart-summary"><h2 class="h5">Resumo da compra</h2><div class="d-flex justify-content-between py-3 border-bottom"><span><%= totalItens %> item(ns)</span><strong><%= formatarValor(total) %></strong></div><%- include('../partials/cupons', {paginaCupom: 'sacola'}) %>
<div class="cupom-price-row"><span>Subtotal dos produtos</span><strong><%= formatarValor(promocao.subtotal) %></strong></div>
<% if(promocao.desconto>0){ %><div class="cupom-price-row discount"><span>Desconto musical (10%)</span><strong>− <%= formatarValor(promocao.desconto) %></strong></div><% } %>
<div class="cupom-price-row"><span>Frete</span><span><%= promocao.freteGratis ? 'Grátis com FRETE2700 (entrega)' : 'A combinar na entrega' %></span></div>
<div class="cupom-price-row cupom-price-total"><strong>Total dos produtos</strong><strong class="text-danger"><%= formatarValor(promocao.totalFinal) %></strong></div>
<p class="small text-muted my-2">Pedidos com entrega sem cupom de frete continuam sujeitos a orçamento; o frete não está incluído no total acima.</p><a href="/carrinho/confirmar" class="btn btn-dark py-3">Continuar para entrega <i class="bi bi-arrow-right"></i></a></div></aside></div><% } %>
</main><%- include('../partials/footer') %></body></html>
